# ÑÑÐ¾Ð±Ñ /api/* Ð¸ /docs Ð¾Ð±ÑÐ°Ð±Ð°ÑÑÐ²Ð°Ð»Ð¸ÑÑ FastAPI.
app.mount("/", StaticFiles(directory=Path(__file__).resolve().parent.parent, html=True), name="frontend")
